{
  "name": "website",
  "version": "1.0.0",
  "description": "Personal website with static homepage and 11ty blog",
  "scripts": {
    "build": "node scripts/build.js",
    "build:blog": "npm --prefix blog run build:site",
    "build:sandwich": "node scripts/sandwich.mjs",
    "dev:sandwich": "node scripts/sandwich.mjs --serve",
    "test:sandwich": "node --test sandwich/tests/*.test.mjs",
    "dev:blog": "npm --prefix blog run dev --",
    "check": "node scripts/check.js",
    "review:sandwich-performance": "node scripts/sandwich.mjs --performance"
  },
  "license": "MIT",
  "dependencies": {
    "cannon-es": "^0.20.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
