<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% set pageTitle = site.name %}
    {% if title %}{% set pageTitle = title ~ ' | ' ~ site.name %}{% endif %}
    {% set pageDescription = description or site.description %}
    {% set pageUrl = page.url | url | absoluteUrl(site.url) %}
    {% set imageAlt = 'Corey Kozarski, London. Blog with a green cursor, bold lettering on a light dot grid, and Hello circled in red.' %}
    <link rel="canonical" href="{{ pageUrl }}">
    <link rel="alternate" type="application/rss+xml" href="/feed.xml" title="RSS Feed for {{ site.name }}">
    <link rel="preload" href="/fonts/3e0a37bc36e5a3325e58.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/535bc89d4af715503b01.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="icon" type="image/png" href="/images/copyleft.png">

    <title>{{ pageTitle | escape }}</title>
    <meta name="description" content="{{ pageDescription | escape }}">
    <meta property="og:title" content="{{ pageTitle | escape }}">
    <meta property="og:description" content="{{ pageDescription | escape }}">
    <meta property="og:type" content="{% if tags and 'posts' in tags %}article{% else %}website{% endif %}">
    <meta property="og:url" content="{{ pageUrl }}">
    <meta property="og:site_name" content="{{ site.author.name | escape }}">
    <meta property="og:image" content="{{ site.defaultSocialImage }}">
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="{{ imageAlt | escape }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ pageTitle | escape }}">
    <meta name="twitter:description" content="{{ pageDescription | escape }}">
    <meta name="twitter:image" content="{{ site.defaultSocialImage }}">
    <meta name="twitter:image:alt" content="{{ imageAlt | escape }}">

  </head>
  <body>
    <div class="container">

      <header class="header">
        <div class="header__content">
          <h1 class="site-title">
            <a href="/">{{site.name}}</a>
          </h1>
          {% if site.headerLinks %}
            <nav class="nav">
              <ul class="nav__list">
                {% for item in site.headerLinks %}
                  {% set currentAttribute = '' %}
                  {% if page.url == item.url %}
                    {% set currentAttribute = 'aria-current="page"' %}
                  {% endif %}
                  <li class="nav-item">
                    <a href="{{ item.url }}" {{ currentAttribute | safe }}>{{ item.text }}</a>
                  </li>
                {% endfor %}
              </ul>
            </nav>
          {% endif %}
        </div>
      </header>

      <main class="main">
        {{ content | safe }}
      </main>

      <footer class="footer">
        <div class="footer__content">
          <p class="footer-quote shimmer">"{{ site.quote }}"</p>
          <p class="meta">built with <a href="https://www.11ty.dev" target="_blank">11ty</a>. on a modified <a href="https://github.com/yinkakun/eleventy-duo/tree/master" target="_blank">Duo</a>. last build - {{ build.timestamp | readableDate('yyyy') }}.</p>
          <p class="separator">◦◦◦◦</p>
        </div>
      </footer>

    </div>
  </body>
</html>
